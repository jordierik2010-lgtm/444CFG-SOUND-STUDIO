{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "444CFG Sound Studio",
  "mainBinaryName": "444CFG-Sound-Studio",
  "version": "1.0.0",
  "identifier": "gg.cfg444.soundstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "444CFG SOUND STUDIO", "width": 1360, "height": 860, "minWidth": 1100, "minHeight": 700, "decorations": false, "center": true, "backgroundColor": "#05060d" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] } }
  }
}
